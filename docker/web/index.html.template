<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TP Docker - Web et DB</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6fb;
      color: #1f2937;
    }

    main {
      max-width: 760px;
      margin: 80px auto;
      padding: 32px;
      background: white;
      border: 1px solid #d8deea;
