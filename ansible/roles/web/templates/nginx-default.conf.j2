server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html;
    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }
}

{% if enable_https %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    root /var/www/html;
    index index.html;
    server_name _;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    location / {
        try_files $uri $uri/ =404;
    }
}
{% endif %}
